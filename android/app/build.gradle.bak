
android {
    defaultConfig {
        ndk {
            abiFilters "arm64-v8a"
        }
        externalNativeBuild {
            cmake {
                cppFlags "-O2 -std=c++17"
                arguments "-DANDROID_STL=c++_shared"
            }
        }
    }
    externalNativeBuild {
        cmake {
            path file("$projectDir/src/main/cpp/CMakeLists.txt")
            version "3.22.1"
        }
    }
}
