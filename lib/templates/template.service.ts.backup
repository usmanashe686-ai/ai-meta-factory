import { 
  collection, 
  doc, 
  getDoc, 
  getDocs, 
  query, 
  where, 
  orderBy, 
  limit, 
  startAfter,
  updateDoc,
  increment,
  addDoc,
  serverTimestamp,
  DocumentSnapshot,
  QueryConstraint
} from 'firebase/firestore'
import { db } from '@/lib/firebase/client'
import { 
  Template, 
  TemplateReview, 
  TemplateSearchFilters 
} from './template.types'

export class TemplateService {
  private templatesCollection = collection(db, 'templates')
  private reviewsCollection = collection(db, 'template_reviews')
  private interactionsCollection = collection(db, 'template_interactions')

  /**
   * Get template by ID
   */
  async getTemplate(id: string): Promise<Template | null> {
    try {
      const templateDoc = await getDoc(doc(db, 'templates', id))
      
      if (!templateDoc.exists()) {
        return null
      }
      
      return {
        id: templateDoc.id,
        ...templateDoc.data()
      } as Template
    } catch (error) {
      console.error('Error getting template:', error)
      return null
    }
  }

  /**
   * Search templates with filters
   */
  async searchTemplates(filters: TemplateSearchFilters): Promise<{
    templates: Template[]
    total: number
    page: number
    totalPages: number
  }> {
    try {
      const {
        category,
        search,
        minRating = 0,
        price = 'all',
        difficulty,
        tags,
        sortBy = 'popular',
        page = 1,
        limit: itemsPerPage = 12
      } = filters

      // Build query constraints
      const constraints: QueryConstraint[] = []

      // Category filter
      if (category && category !== 'all') {
        constraints.push(where('category', '==', category))
      }

      // Price filter
      if (price === 'free') {
        constraints.push(where('price', '==', 'free'))
      } else if (price === 'paid') {
        constraints.push(where('price', '!=', 'free'))
      }

      // Difficulty filter
      if (difficulty && difficulty !== 'all') {
        constraints.push(where('metadata.difficulty', '==', difficulty))
      }

      // Minimum rating filter
      if (minRating > 0) {
        constraints.push(where('rating', '>=', minRating))
      }

      // Featured filter
      if (filters.featured) {
        constraints.push(where('featured', '==', true))
      }

      // Sorting
      switch (sortBy) {
        case 'newest':
          constraints.push(orderBy('createdAt', 'desc'))
          break
        case 'rating':
          constraints.push(orderBy('rating', 'desc'))
          break
        case 'downloads':
          constraints.push(orderBy('downloadCount', 'desc'))
          break
        case 'trending':
          constraints.push(orderBy('popularityScore', 'desc'))
          break
        case 'popular':
        default:
          constraints.push(orderBy('usageCount', 'desc'))
          break
      }

      // Pagination
      const startIndex = (page - 1) * itemsPerPage
      if (startIndex > 0) {
        // Need to get document to start after (simplified)
        // In production, you'd implement proper cursor pagination
      }

      constraints.push(limit(itemsPerPage))

      // Execute query
      const templatesQuery = query(this.templatesCollection, ...constraints)
      const snapshot = await getDocs(templatesQuery)

      // Get total count (simplified - in production, use a separate count query)
      const totalSnapshot = await getDocs(this.templatesCollection)
      const total = totalSnapshot.size

      const templates = snapshot.docs.map(doc => ({
        id: doc.id,
        ...doc.data()
      })) as Template[]

      // Apply search filter client-side for simplicity
      // In production, use Firestore text search or Algolia
      let filteredTemplates = templates
      if (search) {
        const searchLower = search.toLowerCase()
        filteredTemplates = templates.filter(template =>
          template.name.toLowerCase().includes(searchLower) ||
          template.description.toLowerCase().includes(searchLower) ||
          template.tags.some(tag => tag.toLowerCase().includes(searchLower))
        )
      }

      // Tag filter
      if (tags && tags.length > 0) {
        filteredTemplates = filteredTemplates.filter(template =>
          tags.every(tag => template.tags.includes(tag))
        )
      }

      return {
        templates: filteredTemplates,
        total,
        page,
        totalPages: Math.ceil(total / itemsPerPage)
      }

    } catch (error) {
      console.error('Error searching templates:', error)
      return {
        templates: [],
        total: 0,
        page: 1,
        totalPages: 0
      }
    }
  }

  /**
   * Get templates by author
   */
  async getTemplatesByAuthor(authorId: string, limit = 10): Promise<Template[]> {
    try {
      const templatesQuery = query(
        this.templatesCollection,
        where('authorId', '==', authorId),
        orderBy('createdAt', 'desc'),
        limit(limit)
      )
      
      const snapshot = await getDocs(templatesQuery)
      return snapshot.docs.map(doc => ({
        id: doc.id,
        ...doc.data()
      })) as Template[]
    } catch (error) {
      console.error('Error getting author templates:', error)
      return []
    }
  }

  /**
   * Get featured templates
   */
  async getFeaturedTemplates(limit = 6): Promise<Template[]> {
    try {
      const featuredQuery = query(
        this.templatesCollection,
        where('featured', '==', true),
        orderBy('createdAt', 'desc'),
        limit(limit)
      )
      
      const snapshot = await getDocs(featuredQuery)
      return snapshot.docs.map(doc => ({
        id: doc.id,
        ...doc.data()
      })) as Template[]
    } catch (error) {
      console.error('Error getting featured templates:', error)
      return []
    }
  }

  /**
   * Get trending templates
   */
  async getTrendingTemplates(limit = 8): Promise<Template[]> {
    try {
      const trendingQuery = query(
        this.templatesCollection,
        where('trending', '==', true),
        orderBy('popularityScore', 'desc'),
        limit(limit)
      )
      
      const snapshot = await getDocs(trendingQuery)
      return snapshot.docs.map(doc => ({
        id: doc.id,
        ...doc.data()
      })) as Template[]
    } catch (error) {
      console.error('Error getting trending templates:', error)
      return []
    }
  }

  /**
   * Get similar templates
   */
  async getSimilarTemplates(templateId: string, limit = 4): Promise<Template[]> {
    try {
      const template = await this.getTemplate(templateId)
      if (!template) return []

      const similarQuery = query(
        this.templatesCollection,
        where('category', '==', template.category),
        where('metadata.difficulty', '==', template.metadata.difficulty),
        orderBy('rating', 'desc'),
        limit(limit)
      )
      
      const snapshot = await getDocs(similarQuery)
      return snapshot.docs
        .map(doc => ({ id: doc.id, ...doc.data() } as Template))
        .filter(t => t.id !== templateId)
        .slice(0, limit)
    } catch (error) {
      console.error('Error getting similar templates:', error)
      return []
    }
  }

  /**
   * Create a new template
   */
  async createTemplate(templateData: Partial<Template>, authorId: string): Promise<string | null> {
    try {
      const newTemplate = {
        ...templateData,
        authorId,
        createdAt: serverTimestamp(),
        updatedAt: serverTimestamp(),
        publishedAt: serverTimestamp(),
        
        // Default stats
        rating: 0,
        reviewCount: 0,
        viewCount: 0,
        downloadCount: 0,
        usageCount: 0,
        likeCount: 0,
        bookmarkCount: 0,
        
        featured: false,
        trending: false,
        verified: false,
        
        popularityScore: 0,
        qualityScore: 70,
        
        version: '1.0.0',
        lastUpdated: serverTimestamp()
      }

      const docRef = await addDoc(this.templatesCollection, newTemplate)
      return docRef.id
    } catch (error) {
      console.error('Error creating template:', error)
      return null
    }
  }

  /**
   * Update template stats
   */
  async incrementTemplateStat(templateId: string, stat: string, value: number = 1): Promise<boolean> {
    try {
      const templateRef = doc(db, 'templates', templateId)
      await updateDoc(templateRef, {
        [stat]: increment(value),
        updatedAt: serverTimestamp()
      })
      return true
    } catch (error) {
      console.error(`Error incrementing ${stat}:`, error)
      return false
    }
  }

  /**
   * Track template interaction
   */
  async trackInteraction(
    userId: string,
    templateId: string,
    type: 'view' | 'download' | 'like' | 'bookmark' | 'use',
    metadata?: any
  ): Promise<void> {
    try {
      await addDoc(this.interactionsCollection, {
        userId,
        templateId,
        type,
        metadata,
        createdAt: serverTimestamp()
      })

      // Update template stats
      const statMap = {
        view: 'viewCount',
        download: 'downloadCount',
        like: 'likeCount',
        bookmark: 'bookmarkCount',
        use: 'usageCount'
      }

      if (statMap[type]) {
        await this.incrementTemplateStat(templateId, statMap[type])
      }
    } catch (error) {
      console.error('Error tracking interaction:', error)
    }
  }

  /**
   * Add template review
   */
  async addReview(
    templateId: string,
    userId: string,
    reviewData: Partial<TemplateReview>
  ): Promise<string | null> {
    try {
      const review = {
        templateId,
        userId,
        ...reviewData,
        helpfulCount: 0,
        createdAt: serverTimestamp(),
        updatedAt: serverTimestamp()
      }

      const docRef = await addDoc(this.reviewsCollection, review)
      return docRef.id
    } catch (error) {
      console.error('Error adding review:', error)
      return null
    }
  }

  /**
   * Get template reviews
   */
  async getTemplateReviews(templateId: string, limit = 10): Promise<TemplateReview[]> {
    try {
      const reviewsQuery = query(
        this.reviewsCollection,
        where('templateId', '==', templateId),
        orderBy('createdAt', 'desc'),
        limit(limit)
      )
      
      const snapshot = await getDocs(reviewsQuery)
      return snapshot.docs.map(doc => ({
        id: doc.id,
        ...doc.data()
      })) as TemplateReview[]
    } catch (error) {
      console.error('Error getting reviews:', error)
      return []
    }
  }

  /**
   * Get user's templates
   */
  async getUserTemplates(userId: string): Promise<Template[]> {
    try {
      const templatesQuery = query(
        this.templatesCollection,
        where('authorId', '==', userId),
        orderBy('createdAt', 'desc')
      )
      
      const snapshot = await getDocs(templatesQuery)
