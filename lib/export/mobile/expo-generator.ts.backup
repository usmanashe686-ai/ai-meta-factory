    `.trim();
  }

  private static createAppConfig(project: Project): any {
    const slug = project.name
      .toLowerCase()
      .replace(/\s+/g, '-')
      .replace(/[^a-z0-9-]/g, '');

    return {
      expo: {
        name: project.name,
        slug: slug,
        version: project.version || '1.0.0',
        orientation: 'portrait',
        icon: './assets/icon.png',
        userInterfaceStyle: 'light',
        splash: {
          image: './assets/splash.png',
          resizeMode: 'contain',
          backgroundColor: '#ffffff'
        },
        assetBundlePatterns: ['**/*'],
        ios: {
          supportsTablet: true,
          bundleIdentifier: `com.aifactory.${slug}`,
          buildNumber: '1.0.0'
        },
        android: {
          adaptiveIcon: {
            foregroundImage: './assets/adaptive-icon.png',
            backgroundColor: '#ffffff'
          },
          package: `com.aifactory.${slug}`,
          versionCode: 1,
          permissions: []
        },
        web: {
          favicon: './assets/favicon.png',
          bundler: 'metro'
        },
        extra: {
          eas: {
            projectId: this.generateProjectId()
          }
        },
        plugins: [
          'expo-font',
          'expo-asset',
          [
            'expo-splash-screen',
            {
              backgroundColor: '#ffffff',
              image: './assets/splash.png',
              resizeMode: 'contain'
            }
          ]
        ]
      }
    };
  }

  private static createEasConfig(project: Project): any {
    const slug = project.name
      .toLowerCase()
      .replace(/\s+/g, '-')
      .replace(/[^a-z0-9-]/g, '');

    return {
      cli: {
        version: '>= 6.0.0'
      },
      build: {
        development: {
          developmentClient: true,
          distribution: 'internal',
          android: {
            buildType: 'apk'
          }
        },
        preview: {
          android: {
            buildType: 'apk'
          }
        },
        production: {
          android: {
            buildType: 'aab',
            gradleCommand: ':app:bundleRelease'
          }
        }
      },
      submit: {
        production: {}
      }
    };
  }

  private static createReadme(project: Project): string {
    const currentDate = new Date().toLocaleDateString();
    
    return `# ${project.name}

> Generated by AI Meta-Software Factory - ${currentDate}

${project.description || 'A React Native mobile application generated from web components.'}

## 📱 App Details

- **Name**: ${project.name}
- **Version**: ${project.version || '1.0.0'}
- **Platform**: Android/iOS/Web
- **Generated**: ${currentDate}
- **Framework**: React Native + Expo

## 🚀 Quick Start

### Prerequisites
- Node.js 16+
- npm or yarn
- Expo CLI (\`npm install -g expo-cli\`)
- Android Studio (for Android builds)
- Xcode (for iOS builds - macOS only)

### Installation

\`\`\`bash
# Install dependencies
npm install

# Start development server
npm start
\`\`\`

### Development

1. **Run on Android**:
   \`\`\`bash
   npm run android
   \`\`\`

2. **Run on iOS**:
   \`\`\`bash
   npm run ios
   \`\`\`

3. **Run on Web**:
   \`\`\`bash
   npm run web
   \`\`\`

## 📦 Build for Production

### Android APK (Preview)
\`\`\`bash
npm run build:apk
\`\`\`

### Android AAB (Production - Google Play)
\`\`\`bash
npm run build:aab
\`\`\`

### Using Expo Application Services (EAS)
\`\`\`bash
# Install EAS CLI
npm install -g eas-cli

# Login to Expo
eas login

# Build for Android
eas build --platform android --profile production
\`\`\`

## 🏗️ Project Structure

\`\`\`
.
├── App.js                 # Main application entry point
├── app.json              # Expo configuration
├── eas.json              # EAS build configuration
├── package.json          # Dependencies
├── components/           # Generated components
│   ├── Component0.js
│   ├── Component1.js
│   └── ...
├── assets/               # App assets (icons, images)
└── README.md             # This file
\`\`\`

## 🎨 Customization

### Editing Components
All generated components are in the \`components/\` directory. Edit them to customize your app:

\`\`\`javascript
// components/Component0.js
import React from 'react';
import { View, Text, StyleSheet } from 'react-native';

export const Component0 = () => {
  return (
    <View style={styles.container}>
      <Text>Edit me!</Text>
    </View>
  );
};

const styles = StyleSheet.create({
  container: {
    padding: 16,
  },
});
\`\`\`

### Adding New Features
1. Install additional packages: \`npm install <package-name>\`
2. Import and use them in your components
3. Update \`app.json\` if needed for permissions

## 🔧 Configuration Files

### app.json
Expo configuration including app name, icons, splash screen, and platform settings.

### eas.json
Expo Application Services configuration for cloud builds.

## 🧪 Testing

Run the test suite:
\`\`\`bash
npm test
\`\`\`

## 📊 Analytics & Monitoring

To add analytics:
1. Install: \`expo install expo-analytics\`
2. Configure in \`App.js\`

## 🔐 Environment Variables

Create a \`.env\` file:
\`\`\`
API_URL=https://api.example.com
API_KEY=your_api_key_here
\`\`\`

Then install \`react-native-dotenv\` and configure in \`babel.config.js\`.

## 🤝 Contributing

This app was automatically generated. To contribute:
1. Edit the source components
2. Add new features as needed
3. Rebuild the app

